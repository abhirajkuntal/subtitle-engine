{
  "manifest_version": 3,
  "name": "Bilingual Subtitle Engine",
  "version": "1.0.0",
  "description": "Extracts, translates, and color-codes media subtitles.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "action": {
    "default_title": "Open Learning Dashboard"
  }
}
